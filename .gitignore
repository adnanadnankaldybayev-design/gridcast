# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
build/
dist/

# Data: raw snapshots and processed parquet are artifacts, not source
data/raw/**
data/processed/**
!data/raw/.gitkeep
!data/processed/.gitkeep
*.parquet

# Secrets / env
.env

# Reports: timestamped artifacts are reproducible from code at their stamped
# SHA — never commit them; rolling latest_* snapshots and the benchmark card
# ARE committed
reports/*
!reports/latest_*
!reports/BENCHMARK.md
!reports/.gitkeep

# OS / editors
.DS_Store
Thumbs.db
.vscode/

# Daily forecast snapshots are artifacts, not source
data/forecasts/**
